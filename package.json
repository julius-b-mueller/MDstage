{
  "name": "evb-ai",
  "productName": "Main Desk",
  "version": "1.0.0",
  "description": "Das interaktive Inspizientenbuch",
  "author": {
    "name": "Julius Müller",
    "email": "info@maindesk.org"
  },
  "homepage": "https://essener-volksbuehne.github.io/evb-ai",
  "main": "electron/main.js",
  "scripts": {
    "build": "webpack && node scripts/copy-preview.js && node scripts/build-version.js && electron-builder --publish never",
    "build:renderer": "webpack",
    "build:preview": "webpack --mode production && node scripts/copy-preview.js",
    "build:version": "node scripts/build-version.js",
    "develop": "webpack --watch --progress",
    "start": "node scripts/patch-electron-macos.js && electron .",
    "postinstall": "node scripts/patch-electron-macos.js"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "dompurify": "^3.4.7",
    "electron": "^36.0.0",
    "electron-builder": "^26.8.1",
    "showdown": "^2.1.0",
    "wavesurfer.js": "^7.12.7",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webmidi": "^3.0.21"
  },
  "build": {
    "appId": "de.maindesk.app",
    "productName": "Main Desk",
    "icon": "dist/assets/icon.png",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb",      "arch": ["x64"] },
        { "target": "rpm",      "arch": ["x64"] }
      ],
      "category": "AudioVideo"
    }
  }
}
